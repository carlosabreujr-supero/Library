# Copie para .env e ajuste. O arquivo .env não é versionado.
POSTGRES_DB=library_loans
POSTGRES_USER=library
POSTGRES_PASSWORD=change-me-local-only
API_PORT=8080
LOAN_DEFAULT_DAYS=14
IDEMPOTENCY_RETENTION_HOURS=24
CACHE_ENABLED=true
CACHE_TTL_SECONDS=30
HEALTH_REDIS_REQUIRED=false
OTEL_SERVICE_NAME=LibraryLoans.Api
# Opcional: endpoint OTLP (ex.: http://otel-collector:4317). Vazio = sem exportacao.
OTEL_EXPORTER_OTLP_ENDPOINT=
